# ── AI ────────────────────────────────────────────────────────────────────────
# All five AI Studio keys, comma separated. The pool rotates across them so one
# rate-limited key never stalls the nightly ingest. Get keys at
# https://aistudio.google.com -> "Get API key".
GEMINI_API_KEYS=key1,key2,key3,key4,key5
# Optional. Leave unset to use the model pinned in lib/ai/gemini.ts.
GEMINI_MODEL=

# Blog post drafting only — the chatbot and job summaries stay on Gemini above.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ── Database (Supabase) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
# Supabase now calls this the "publishable" key; the anon key still works too.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase now calls this the "secret" key; the service_role key still works too.
# Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Job source ────────────────────────────────────────────────────────────────
# Careerjet Partners API v4 key. Register as a publisher:
# https://www.careerjet.com/partners/api  (the old affid/legacy API is closed to new partners)
CAREERJET_API_KEY=
CAREERJET_LOCALE=en_AE
# Optional: the public IP of the machine running the ingest, if Careerjet asks for one.
CAREERJET_USER_IP=

# ── Lead routing ──────────────────────────────────────────────────────────────
# Sales WhatsApp number in international format, no plus sign. Used for the
# click-to-chat links visitors tap.
WHATSAPP_NUMBER=9715XXXXXXXX

# Telegram alert for new leads: create a bot with @BotFather, then get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts via Resend (https://resend.com).
RESEND_API_KEY=
LEAD_ALERT_EMAIL=sales@yourdomain.ae
LEAD_ALERT_FROM=alerts@yourdomain.ae

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for the cron routes. Generate: openssl rand -hex 32
CRON_SECRET=
