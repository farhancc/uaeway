# ── AI ────────────────────────────────────────────────────────────────────────
# Comma separated, as many as you have. The pool round-robins across them so one
# rate-limited key never stalls the nightly ingest, and benches a key that is out
# of quota. Both key formats Google issues work here: the "AIza…" keys from
# https://aistudio.google.com -> "Get API key", and the "AQ.…" ones.
GEMINI_API_KEYS=key1,key2,key3
# Optional. Leave unset to use the model pinned in lib/ai/gemini.ts.
GEMINI_MODEL=

# Blog post drafting only — the chatbot and job summaries stay on Gemini above.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ── Database (Supabase) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
# Supabase now calls this the "publishable" key; the anon key still works too.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase now calls this the "secret" key; the service_role key still works too.
# Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Job sources ───────────────────────────────────────────────────────────────
# Jooble is the default source: free, covers the UAE, and built for publishers.
# Get a key from the short form at https://jooble.org/api/about
JOOBLE_API_KEY=
# Optional. Jooble caps this itself.
JOOBLE_PAGE_SIZE=20

# Optional second source. Careerjet is also free but needs publisher approval:
# https://www.careerjet.com/partners/api  (the old affid/legacy API is closed to
# new partners). Leave blank and it sits out; both can run together.
CAREERJET_API_KEY=
CAREERJET_LOCALE=en_AE
# Optional: the public IP of the machine running the ingest, if Careerjet asks for one.
CAREERJET_USER_IP=

# ── Lead routing ──────────────────────────────────────────────────────────────
# Telegram alert for new leads: create a bot with @BotFather, then get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts via Resend (https://resend.com).
RESEND_API_KEY=
LEAD_ALERT_EMAIL=sales@yourdomain.ae
LEAD_ALERT_FROM=alerts@yourdomain.ae

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for the cron routes. Generate: openssl rand -hex 32
CRON_SECRET=
