# Copy to .env and fill in. .env is gitignored; .env.example must stay
# placeholders only.

# --- The site ---------------------------------------------------------------

# Same Mongo cluster the site uses. The worker touches two collections of its
# own, `whatsapp_auth` and `whatsapp_posted`, and never reads the chat data.
MONGODB_URI=
# The real database name — see lib/mongo/chat-db.ts in the site.
MONGODB_DB=uaevia

# The endpoint that returns the approved listings. The worker asks for
# `?format=json`, which the site answers with rows rather than ready-made text.
# Local: http://localhost:3000/api/digest
DIGEST_URL=https://your-domain.com/api/digest

# Where scraped listings are posted. Defaults to /api/ingest/jobs on the same
# origin as DIGEST_URL, so you only need this if they differ.
# INGEST_URL=

# The public site, for the one link the worker writes itself (the attestation
# nudge). Defaults to DIGEST_URL's origin.
# SITE_URL=https://your-domain.com

# Must match CRON_SECRET in the site's environment, or both endpoints 401.
CRON_SECRET=

# Printed by `npm run pair`. Looks like 120363041234567890@g.us
WHATSAPP_GROUP_JID=

# --- Google, through Serper -------------------------------------------------

# https://serper.dev — the free allowance is a fixed number of credits, not a
# monthly one, so watch the arithmetic below.
SERPER_API_KEY=

# EVERY QUERY IS ONE CREDIT, and a run is keywords x locations x boards.
# Two boards are configured in src/serper.ts, so the defaults below are
# 6 x 2 x 2 = 24 credits per run, and SCRAPE_CRON runs twice a day = 48 a day.
# Adding one keyword adds 4 credits a run, 8 a day, ~240 a month.
# SERPER_KEYWORDS=accountant,sales executive,driver,nurse,receptionist,engineer
# SERPER_LOCATIONS=Dubai,Abu Dhabi

# Results per query. 10 is one credit; more costs more.
# SERPER_NUM=10

# --- Schedules --------------------------------------------------------------

# Every hour from 7am to 10pm India time — sixteen posts a day. A post only
# goes out if there are approved listings the group has not already been sent,
# so quiet hours are silent rather than repetitive.
POST_CRON=0 7-22 * * *

# The scrape is deliberately NOT hourly: Google's index of a job board does not
# change within an hour, and sixteen scrapes a day would be 384 credits a day.
SCRAPE_CRON=0 7,14 * * *

# Changing the zone is enough; no UTC arithmetic anywhere.
POST_TZ=Asia/Kolkata

# --- Posting shape ----------------------------------------------------------

# Listings per message, at most.
# JOBS_PER_POST=3
# How many approved listings to pull and compare against the posted log.
# BOARD_POOL_SIZE=60
# Posts land up to this many minutes after the hour, at random, so the feed
# does not read as a machine.
# JITTER_MINUTES=7

# --- Local status server ----------------------------------------------------

# Loopback only. `POST /run` and `POST /scrape` are guarded by CRON_SECRET.
# PORT=3100
# HOST=127.0.0.1

# Baileys is extremely chatty below "warn".
LOG_LEVEL=warn
